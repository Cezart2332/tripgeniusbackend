# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example_password
POSTGRES_DB=tripgenius
# Connection string for the backend to connect to the 'db' service
DB_CONNECTION_STRING=Host=db;Database=tripgenius;Username=postgres;Password=example_password

# JWT
JWT_KEY=super-secret-key-at-least-32-characters-long
JWT_ISSUER=tripgenius
JWT_AUDIENCE=tripgenius
JWT_ACCESS_TOKEN_EXPIRY=15
JWT_REFRESH_TOKEN_EXPIRY=7

# External APIs
